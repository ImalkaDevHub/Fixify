APP_ENV=development
DATABASE_URL=postgresql+psycopg://fixify:change-me-locally@localhost:5432/fixify
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true
DATABASE_CONNECT_TIMEOUT_SECONDS=5
QUEUE_BACKEND=redis
# ARTIFACT_DIR defaults to services/api/.artifacts
ARTIFACT_RETENTION_DAYS=14
ARTIFACT_MAX_BYTES=5000000
SCANNER_NAVIGATION_TIMEOUT_SECONDS=30
SCANNER_MAX_SCAN_DURATION_SECONDS=180
SCANNER_MAX_LINKS=25
SCANNER_LINK_CONCURRENCY=4
SCANNER_LINK_TIMEOUT_SECONDS=8
SCANNER_ALLOWED_PORTS=80,443,8080,8443
# DEVELOPMENT ONLY: host:port pairs allowed to resolve to private addresses (local test sites).
SCANNER_UNSAFE_ALLOWED_HOSTS=
SCANNER_MAX_QUEUED_SCANS=20
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=5
SCAN_MAX_ATTEMPTS=2
API_CORS_ORIGINS=http://localhost:3000

# --- Authentication ------------------------------------------------------------------------
# Required (32+ chars) when APP_ENV=production; random per process in development.
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Empty = Secure cookies only in production.
# COOKIE_SECURE=true
PUBLIC_APP_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_TIME_COST=3
AUTH_RATE_LIMIT_PER_IP=30
AUTH_RATE_LIMIT_PER_ACCOUNT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# --- Email ---------------------------------------------------------------------------------
EMAIL_BACKEND=console
EMAIL_FROM=Fixify <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# --- Per-user limits -----------------------------------------------------------------------
MAX_PROJECTS_PER_USER=50
MAX_ACTIVE_SCANS_PER_USER=3
# Website ownership verification before scanning; unset = required in production only.
# REQUIRE_SITE_VERIFICATION=true

# --- AI ------------------------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=16000
AI_REFUSAL_FALLBACK=true
AI_JOBS_PER_USER_PER_HOUR=30

# --- GitHub --------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_FILE_BYTES=150000
GITHUB_MAX_FILES_PER_FIX=5
GITHUB_MAX_CONTEXT_BYTES=200000
TOKEN_ENCRYPTION_KEY=

# --- Background jobs and scheduling -----------------------------------------------------------
JOB_MAX_ATTEMPTS=3
JOB_CONCURRENCY=2
SCHEDULER_INTERVAL_SECONDS=30
MIN_SCHEDULE_INTERVAL_HOURS=6

# --- API server (python -m app.serve) ----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
