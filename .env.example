# Copy to .env (git-ignored) and change the placeholders. Read by the API, the worker, and
# Docker Compose. Every setting with its default and bounds: services/api/.env.example.

APP_ENV=development

# --- Database and queue (self-managed: infra/docker-compose.yml) --------------------------
# Docker Compose creates the database from POSTGRES_*; DATABASE_URL must use the same values.
# Replace the password before the first start (it is fixed when the data volume is created):
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=fixify
POSTGRES_USER=fixify_user
POSTGRES_PASSWORD=change-me-locally
# Host ports. Use e.g. 5433 if a native PostgreSQL already listens on 5432.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# psycopg 3 driver (async in the API/worker, sync in Alembic). Not asyncpg.
# Use 127.0.0.1, not "localhost": Compose publishes on 127.0.0.1 only, and on Windows
# "localhost" resolves to ::1 first, which stalls until the connect timeout.
DATABASE_URL=postgresql+psycopg://fixify_user:change-me-locally@127.0.0.1:5432/fixify
DATABASE_CONNECT_TIMEOUT_SECONDS=5
REDIS_URL=redis://127.0.0.1:6379/0
# "redis" (default) or "database" (fallback without Redis: the worker polls PostgreSQL)
QUEUE_BACKEND=redis
REDIS_REQUIRED=true

# --- Web app and authentication --------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
# Required in production (32+ random characters). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
REQUIRE_EMAIL_VERIFICATION=true
# Prove website ownership (meta tag or /.well-known file) before scanning.
# Empty = required in production only.
# REQUIRE_SITE_VERIFICATION=true

# --- Email: console (development only, links appear in the API log), smtp, or disabled --------
EMAIL_BACKEND=console
EMAIL_FROM=Fixify <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- AI (optional; Fixify works without it and says AI is unavailable) ----------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Low-cost setup: AI_MODEL=claude-haiku-5-5 and AI_EFFORT=low
AI_EFFORT=medium

# --- GitHub (optional; see docs/github-oauth.md) --------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo
# Fernet key for GitHub tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Scanner and worker ----------------------------------------------------------------------
ARTIFACT_RETENTION_DAYS=14
SCANNER_MAX_LINKS=25
SCANNER_MAX_SCAN_DURATION_SECONDS=180
WORKER_CONCURRENCY=1
