APP_ENV=development
POSTGRES_DB=fixify
POSTGRES_USER=fixify
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://fixify:change-me-locally@localhost:5432/fixify
REDIS_URL=redis://localhost:6379/0
API_CORS_ORIGINS=http://localhost:3000
# Scan queue: "redis" (default, needs Redis) or "database" (worker polls PostgreSQL).
QUEUE_BACKEND=redis
# Screenshots are stored in services/api/.artifacts unless ARTIFACT_DIR is set.
ARTIFACT_RETENTION_DAYS=14
SCANNER_MAX_LINKS=25
SCANNER_MAX_SCAN_DURATION_SECONDS=180
WORKER_CONCURRENCY=1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

